# ─────────────────────────────────────────
# Structra — Environment Variables
# cp .env.example .env.local
# ─────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PRODUCTION=

# Stripe Price IDs (optional — for recurring subscription flow)
STRIPE_VERIFICATION_PRICE_ID=
NEXT_PUBLIC_STRIPE_VERIFICATION_PRICE_ID=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Security
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags (optional — defaults shown)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_MAPS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Pricing Configuration — amounts in cents (optional — defaults shown)
CONTRACTOR_VERIFICATION_ANNUAL_PRICE=40000
PROJECT_CREATION_FEE=2999
PROJECT_ACCESS_FEE=999
