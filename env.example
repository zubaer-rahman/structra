# Structra Environment Configuration
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key for admin operations (get from Supabase dashboard > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_MAPS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Google Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Database Configuration
DATABASE_URL=your_database_url
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# API Configuration
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
API_TIMEOUT_MS=30000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Stripe price ID for contractor verification subscription (optional - if not set, will use one-time payment)
NEXT_PUBLIC_STRIPE_VERIFICATION_PRICE_ID=price_your_verification_price_id
# Development webhook secret (used with Stripe CLI for local development)
STRIPE_WEBHOOK_SECRET=whsec_your_development_webhook_secret
# Production webhook secret (create a separate webhook endpoint in Stripe dashboard)
STRIPE_WEBHOOK_SECRET_PRODUCTION=whsec_your_production_webhook_secret

# Pricing Configuration (all amounts in cents)
# Contractor verification annual subscription price (default: $400.00)
CONTRACTOR_VERIFICATION_ANNUAL_PRICE=40000
# Project creation fee (default: $29.99)
PROJECT_CREATION_FEE=2999
# Project access fee (default: $9.99)
PROJECT_ACCESS_FEE=999
